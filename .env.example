# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/hairtsag?schema=public"

# true = mock SMS / QPay / delivery, dummy users, live-drop bot, /dev page, DEMO banner
# false = all mocks, fake users and bot drops are disabled
DEMO_MODE=true

# Secret used to sign session cookies (change in production!)
SESSION_SECRET="change-me-to-a-long-random-string"

# Admin account created by the seed script (never hardcoded)
ADMIN_PHONE="88000000"
ADMIN_PASSWORD="admin-demo-pass"

# Real QPay credentials (only used when DEMO_MODE=false)
QPAY_USERNAME=""
QPAY_PASSWORD=""
QPAY_INVOICE_CODE=""
QPAY_CALLBACK_URL="http://localhost:3000/api/payments/qpay/callback"
